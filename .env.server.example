# Copy this file to .env and replace every CHANGE_ME value.

# PostgreSQL database used by MissionGuard and shown in pgAdmin.
DATABASE_ENABLED=true
POSTGRES_USER=missionguard
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=missionguard_ai
POSTGRES_SCHEMA=missionguard
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

# Seed the official OPS-SAT validation dataset and model registry once.
DATABASE_AUTO_SEED=true
DATABASE_WAIT_ATTEMPTS=60
DATABASE_WAIT_DELAY_SECONDS=2

# pgAdmin web login. Use a real email format and a different password.
PGADMIN_DEFAULT_EMAIL=admin@missionguard.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PGADMIN_PASSWORD

# Published ports. PostgreSQL and pgAdmin are loopback-only by default.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8501
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_EXPOSE_PORT=55432
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050
