# MissionGuard local Docker settings.
# These credentials are intended only for local development on this computer.
# Change them before deploying the project to any public server.

DATABASE_ENABLED=true
POSTGRES_USER=missionguard
POSTGRES_PASSWORD=MissionGuardDB2026_Local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=missionguard_ai
POSTGRES_SCHEMA=missionguard
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

DATABASE_AUTO_SEED=true
DATABASE_WAIT_ATTEMPTS=90
DATABASE_WAIT_DELAY_SECONDS=2

PGADMIN_DEFAULT_EMAIL=admin@missionguard.com
PGADMIN_DEFAULT_PASSWORD=MissionGuardAdmin2026_Local

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8501
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_EXPOSE_PORT=55432
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050
