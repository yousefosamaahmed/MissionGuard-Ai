# MissionGuard runs fully in local mode by default.
# Local mode supports the official OPSSAT analysis, CSV uploads,
# dashboards, model validation, drift monitoring, and reports.
DATABASE_ENABLED=false

# To enable PostgreSQL persistence, change DATABASE_ENABLED to true
# and configure either Option A or Option B below.

# Option A: a single managed/cloud PostgreSQL connection string.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/missionguard_ai?sslmode=require

# Option B: individual PostgreSQL settings.
POSTGRES_USER=missionguard
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=missionguard_ai
POSTGRES_SCHEMA=missionguard
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=10
POSTGRES_POOL_RECYCLE=1800

DATABASE_AUTO_SEED=true
